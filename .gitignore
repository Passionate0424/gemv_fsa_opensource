*.jou
*.str
.Xil/

# LLaMA2 runc 系列应用的软件构建产物（obj*、由 tools/ 生成的权重头文件）
/soc/sdk/software/apps/runc/obj*/
/soc/sdk/software/apps/runc/stories_data.h
/soc/sdk/software/apps/runc/tok512.h
/soc/sdk/software/apps/runc_board/obj*/
/soc/sdk/software/apps/runc_board/stories_data.h
/soc/sdk/software/apps/runc_board/tok512.h
/soc/sdk/software/apps/runc_hwsw_comp/obj*/
/soc/sdk/software/apps/runc_hwsw_comp/stories_data.h
/soc/sdk/software/apps/runc_hwsw_comp/tok512.h
/soc/sdk/software/apps/runc_hwsw_comp/*.mif
/soc/sdk/software/apps/runc_hwsw_comp/*.bin
/soc/sdk/software/apps/memtest/obj*/
/soc/sdk/software/apps/fputest/obj*/

# 交叉编译工具链（本仓库不随包分发，见 scripts/build_picolibc_hwfp.sh / build_gcc_ilp32f_multilib.sh 自行构建）
/soc/sdk/toolchains/

/reports/*
/.vscode/*
**/__pycache__/
